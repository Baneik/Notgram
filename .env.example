# Use "mock" for interface development or "tauri" for the native TDLib runtime.
VITE_TELEGRAM_TRANSPORT=mock

# These values are read only by the Rust process and aren't exposed by Vite.
NOTGRAM_API_ID=
NOTGRAM_API_HASH=
NOTGRAM_TDLIB_PATH=

# Optional TDLib settings.
NOTGRAM_DATABASE_KEY_BASE64=
NOTGRAM_USE_TEST_DC=false
NOTGRAM_SYSTEM_LANGUAGE=zh-CN

{
  "schemaVersion": 1,
  "minimumCompatibleVersion": "0.5.0-rc.1",
  "cacheSchemaVersion": 3,
  "channels": {
    "stable": {
      "acceptPrerelease": false,
      "manifest": "stable/latest.json"
    },
    "candidate": {
      "acceptPrerelease": true,
      "acceptStable": true,
      "manifest": "candidate/latest.json"
    }
  },
  "rollback": {
    "strategy": "forward-only",
    "retainedSignedVersions": 2,
    "allowDowngrades": false
  },
  "dataLifecycle": {
    "storage": "os-user-profile",
    "portableStorage": "os-user-profile",
    "retainOnPortableReplacement": true,
    "retainOnUpgrade": true,
    "retainOnUninstall": true,
    "cleanup": "explicit-user-action"
  }
}
